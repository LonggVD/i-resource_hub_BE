# Copy to .env and fill in real values for local dev.
# In production these MUST be provided by the deployment environment, never committed.

# ----- Database -----
DB_URL=jdbc:mysql://localhost:3306/i-resource_hub?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=changeme

# Use 'validate' or 'none' in production; 'update' is dev-only.
JPA_DDL_AUTO=update

# ----- Server -----
SERVER_PORT=2811

# ----- JWT -----
# Must be at least 32 chars. Generate a fresh one for each environment.
JWT_SECRET=replace-this-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ----- CORS -----
# Comma-separated list, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ----- File upload -----
FILE_UPLOAD_DIR=uploads

# ----- Mail (Gmail SMTP example) -----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your-app-password

# ----- PayOS -----
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn/v2
PAYOS_RETURN_URL=http://localhost:4200/payment/success
PAYOS_CANCEL_URL=http://localhost:4200/payment/cancel
PAYOS_CHECKSUM_KEY=
